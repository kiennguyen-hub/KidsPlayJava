<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/KpBackButton" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/KpHeaderTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Thêm truyện mới" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxMedia"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dashed_rect"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Thêm ảnh"
                android:src="@drawable/ic_camera"
                android:tint="@color/kp_blue" />

            <TextView
                android:id="@+id/tvMediaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Thêm ảnh"
                android:textColor="@color/kp_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMediaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/kp_grey"
            android:textSize="12sp" />

        <TextView
            style="@style/KpLabel"
            android:text="Tên truyện" />
        <EditText
            android:id="@+id/etTitle"
            style="@style/KpInput"
            android:hint="Cô bé quàng khăn đỏ"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/KpLabel"
            android:text="Mô tả" />
        <EditText
            android:id="@+id/etDesc"
            style="@style/KpInput"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Truyện cô bé"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="90dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:singleLine="false" />

        <TextView
            style="@style/KpLabel"
            android:text="Danh mục" />
        <EditText
            android:id="@+id/etCategory"
            style="@style/KpInput"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Truyện"
            android:inputType="none" />

        <EditText
            android:id="@+id/etBody"
            style="@style/KpInput"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Nội dung truyện"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="140dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:singleLine="false"
            android:visibility="gone" />

        <TextView
            style="@style/KpLabel"
            android:text="Độ tuổi phù hợp" />
        <EditText
            android:id="@+id/etAge"
            style="@style/KpInput"
            android:hint="5 - 8 tuổi"
            android:inputType="text" />

        <TextView
            style="@style/KpLabel"
            android:text="Trạng thái" />
        <RadioGroup
            android:id="@+id/rgStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPublish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="44dp"
                android:text="Xuất bản"
                android:textColor="@color/kp_navy"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbHide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:minHeight="44dp"
                android:text="Ẩn"
                android:textColor="@color/kp_navy"
                android:textStyle="bold" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/KpBtn.OutlineBlue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Hủy" />

            <TextView
                android:id="@+id/btnSave"
                style="@style/KpBtn.Blue"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1.2"
                android:text="Lưu truyện" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
